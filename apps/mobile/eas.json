{
  "cli": {
    "version": ">=27.11.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "24.22.3",
      "pnpm": "12.23.0",
      "corepack": true
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "channel": "production"
    }
  }
}

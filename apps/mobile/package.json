{
  "name": "mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build:runtime-packages": "pnpm --filter @base-app/config build && pnpm --filter @base-app/contracts build",
    "start": "pnpm run build:runtime-packages && expo start --dev-client",
    "android": "pnpm run build:runtime-packages && expo run:android",
    "ios": "pnpm run build:runtime-packages && expo run:ios",
    "prebuild": "pnpm run build:runtime-packages && expo prebuild --no-install",
    "export": "pnpm run build:runtime-packages && expo export",
    "eas:development": "eas build --profile development",
    "eas-build-post-install": "pnpm run build:runtime-packages",
    "lint": "node scripts/check-mobile-architecture.cjs && tsx scripts/check-i18n.ts && eslint src scripts/check-i18n.ts app.config.ts jest.config.cjs jest-resolver.cjs metro.config.js metro-resolver.cjs plugins/with-no-ios-ats.cjs plugins/with-secure-android-backup.cjs babel.config.cjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build:runtime-packages && jest --config jest.config.cjs --runInBand"
  },
  "dependencies": {
    "@base-app/config": "workspace:*",
    "@base-app/contracts": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "8.28.0",
    "@tanstack/react-query": "5.108.4",
    "expo": "58.0.26",
    "expo-application": "58.1.2",
    "expo-build-properties": "58.0.12",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.8",
    "expo-dev-client": "58.0.21",
    "expo-linking": "58.0.17",
    "expo-localization": "58.0.5",
    "expo-router": "58.0.32",
    "expo-screen-capture": "58.0.6",
    "expo-system-ui": "58.0.7",
    "expo-updates": "58.0.22",
    "i18next": "27.2.6",
    "react": "19.3.0",
    "react-i18next": "18.0.3",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "eas-cli": "27.11.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3",
    "tsx": "4.23.15"
  }
}

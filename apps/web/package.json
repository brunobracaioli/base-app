{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start",
    "lint": "eslint src scripts next.config.ts instrumentation.ts sentry.server.config.ts sentry.edge.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "app-config:set": "tsx scripts/app-config/cli.ts set",
    "app-config:rollback": "tsx scripts/app-config/cli.ts rollback",
    "app-config:sign": "tsx scripts/app-config/cli.ts sign",
    "app-config:execute": "tsx scripts/app-config/cli.ts execute",
    "app-config:operator:test": "node scripts/test.mjs scripts/app-config",
    "app-config:operator:typecheck": "tsc --ignoreConfig --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler --types node,vitest/globals --skipLibCheck scripts/app-config/*.ts",
    "headers:check": "node scripts/check-security-headers.mjs",
    "db:types": "node scripts/db-types.mjs",
    "site-env:check": "tsx scripts/validate-site-env.ts"
  },
  "dependencies": {
    "@base-app/config": "workspace:*",
    "@base-app/contracts": "workspace:*",
    "@opentelemetry/api": "1.9.0",
    "@sentry/nextjs": "11.17.0",
    "@upstash/ratelimit": "2.2.1",
    "@upstash/redis": "1.41.0",
    "@vercel/functions": "3.11.3",
    "@vercel/otel": "2.3.0",
    "jose": "6.2.18",
    "kysely": "0.29.9",
    "next": "16.4.6",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.39.0",
    "standardwebhooks": "1.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "kysely-codegen": "0.20.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}

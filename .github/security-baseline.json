{
  "schemaVersion": 1,
  "environments": [
    {
      "name": "production",
      "reviewersRequired": true,
      "preventSelfReview": true,
      "deploymentBranches": ["main"],
      "deploymentPolicyType": "branch"
    },
    {
      "name": "production-config",
      "reviewersRequired": true,
      "preventSelfReview": true,
      "deploymentBranches": ["main"],
      "deploymentPolicyType": "branch"
    },
    {
      "name": "release",
      "reviewersRequired": true,
      "preventSelfReview": true,
      "deploymentBranches": ["main"],
      "deploymentPolicyType": "branch"
    }
  ],
  "rulesets": [
    {
      "id": "main",
      "target": "branch",
      "include": ["refs/heads/main"],
      "requiredRuleTypes": [
        "pull_request",
        "required_status_checks",
        "deletion",
        "non_fast_forward"
      ],
      "pullRequest": {
        "approvals": 1,
        "codeOwnerReview": true
      },
      "requiredStatusChecks": ["CI / verify"],
      "forbidBypassActors": true,
      "adminOnlyBypass": false
    },
    {
      "id": "mobile-release-tags",
      "target": "tag",
      "include": ["refs/tags/mobile-v*"],
      "requiredRuleTypes": ["creation", "update", "deletion"],
      "requiredStatusChecks": [],
      "forbidBypassActors": false,
      "adminOnlyBypass": true
    },
    {
      "id": "source-release-tags",
      "target": "tag",
      "include": ["refs/tags/v*"],
      "requiredRuleTypes": ["creation", "update", "deletion"],
      "requiredStatusChecks": [],
      "forbidBypassActors": false,
      "adminOnlyBypass": true
    }
  ],
  "manual": [
    {
      "id": "deployment-branch-policy-type",
      "condition": "environment-policy-type",
      "description": "Verify that each production, production-config, and release Environment is restricted to branch main; GitHub's branch-policy API may omit whether a matching name targets a branch or tag."
    },
    {
      "id": "ruleset-bypass-actors",
      "condition": "ruleset-bypass-actors",
      "description": "Verify that main has no bypass actor and release-tag rulesets allow only repository administrators; GitHub omits bypass_actors from read-only ruleset responses."
    },
    {
      "id": "secret-scanning-and-push-protection",
      "description": "Before making a derived repository public, confirm both settings in Settings > Code security and analysis; the workflow token cannot inspect these repository administration settings."
    },
    {
      "id": "private-vulnerability-reporting",
      "description": "Before making a derived repository public, confirm private vulnerability reporting is enabled in the Security tab; the workflow token cannot inspect this setting."
    }
  ]
}

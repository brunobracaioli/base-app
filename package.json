{
  "name": "base-app",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "tsx packages/tooling/src/dev/local-dev-cli.ts up",
    "dev:stop": "tsx packages/tooling/src/dev/local-dev-cli.ts stop",
    "dev:db:reset": "tsx packages/tooling/src/dev/local-dev-cli.ts db-reset",
    "expo:login": "pnpm --filter mobile exec expo login",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format:check": "prettier --check .",
    "architecture:check": "node packages/tooling/src/architecture/run-dependency-cruiser.mjs",
    "contracts:openapi": "pnpm --filter @base-app/contracts contracts:openapi",
    "app-config:set": "pnpm --filter web app-config:set",
    "app-config:rollback": "pnpm --filter web app-config:rollback",
    "app-config:sign": "pnpm --filter web app-config:sign",
    "app-config:execute": "pnpm --filter web app-config:execute",
    "app-config:operator:test": "pnpm --filter web app-config:operator:test",
    "app-config:operator:typecheck": "pnpm --filter web app-config:operator:typecheck",
    "ci:local": "node --experimental-strip-types packages/tooling/src/ci/local-ci.ts",
    "security:doctor": "tsx packages/tooling/src/security/security-doctor.ts",
    "supabase:config": "tsx packages/tooling/src/guards/supabase-config-cli.ts",
    "supabase:config:check": "tsx packages/tooling/src/guards/supabase-config-cli.ts --check",
    "db:lint-migrations": "tsx packages/tooling/src/guards/db-lint-migrations-cli.ts && tsx packages/tooling/src/guards/audit-writes-cli.ts",
    "db:types": "pnpm --filter web db:types",
    "db:fixtures": "tsx packages/tooling/src/db/generate-pgtap-fixtures.ts",
    "vercel:check": "tsx packages/tooling/src/guards/vercel-config-cli.ts"
  },
  "devDependencies": {
    "@base-app/tooling": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.9.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "supabase": "2.122.1",
    "tsx": "4.23.15",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}

{
  "name": "@base-app/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./extensions": {
      "types": "./src/extensions/index.ts",
      "default": "./src/extensions/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit false --outDir dist",
    "contracts:openapi": "tsc --noEmit false --outDir dist && node scripts/generate-openapi.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}

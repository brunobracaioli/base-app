{
  "name": "@base-app/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./extensions": {
      "types": "./src/extensions/index.ts",
      "import": "./dist/src/extensions/index.js",
      "default": "./dist/src/extensions/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @base-app/config build && vitest run",
    "build": "tsc --noEmit false --outDir dist",
    "contracts:openapi": "pnpm --filter @base-app/config build && tsc --noEmit false --outDir dist && node scripts/generate-openapi.mjs"
  },
  "dependencies": {
    "@base-app/config": "workspace:*",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
